# AgentOS Local Configuration Example
# Copy to .env only for local CLI/development testing.
# Production API keys are stored in macOS Keychain via Settings, never in plaintext files.

AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=47821
AGENTOS_LOG_LEVEL=INFO
AGENTOS_DATA_DIR=
AGENTOS_ALLOW_MOCK_PROVIDER=true

# Optional local Ollama endpoint
AGENTOS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional OpenAI-compatible custom endpoint
AGENTOS_OPENAI_COMPAT_BASE_URL=

# Optional provider API keys (for headless CLI tests only; desktop app uses OS Keychain)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AGENTOS_OPENAI_COMPAT_API_KEY=
